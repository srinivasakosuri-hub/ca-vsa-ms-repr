<Project>
  <PropertyGroup>
    <!-- Enable NuGet Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- ── Core framework ──────────────────────────────────────────── -->
  <ItemGroup Label="Application">
    <PackageVersion Include="WolverineFx" Version="6.24.2" />
    <PackageVersion Include="WolverineFx.FluentValidation" Version="6.24.2" />
    <PackageVersion Include="WolverineFx.Http" Version="6.24.2" />
    <PackageVersion Include="WolverineFx.SqlServer" Version="6.24.2" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.24.2" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>
  <!-- ── Data access ─────────────────────────────────────────────── -->
  <ItemGroup Label="Data">
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="Apache.NMS.ActiveMQ" Version="2.2.0" />
  </ItemGroup>
  <!-- ── API / Presentation ──────────────────────────────────────── -->
  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.17" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.11" />
    <PackageVersion Include="CsvHelper" Version="33.0.1" />
  </ItemGroup>
  <!-- ── Roslyn analyzers ─────────────────────────────────────────── -->
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
  </ItemGroup>
  <!-- ── Testing ──────────────────────────────────────────────────── -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.17" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="FastEndpoints" Version="8.2.0" />
  </ItemGroup>
</Project>